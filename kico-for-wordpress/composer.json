{
  "name": "kico/kico-for-wordpress",
  "description": "Connects a WordPress site to Kico.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "automattic/jetpack-autoloader": "^6.0",
    "wordpress/mcp-adapter": "^0.7.1"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": { "automattic/jetpack-autoloader": true, "composer/installers": true }
  }
}
